{
  "name": "colleges",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "data:rankings": "tsx scripts/fetch-rankings.ts",
    "data:forbes": "tsx scripts/fetch-forbes-top75.ts",
    "data:usnews": "tsx scripts/fetch-usnews-top75.ts",
    "data:scorecard": "tsx scripts/enrich-scorecard.ts",
    "data:build": "tsx scripts/build-dataset.ts",
    "data:refresh": "npm run data:rankings && npm run data:scorecard && npm run data:build",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.45.3",
    "leaflet": "1.9.4",
    "next": "^15.5.27",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "5.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.15",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/uuid": "^10.0.0",
    "cheerio": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.21.0",
    "eslint-config-next": "15.1.7",
    "tsx": "4.20.5",
    "typescript": "5.8.2"
  }
}
