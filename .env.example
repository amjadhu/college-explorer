# U.S. Department of Education College Scorecard API key
# Get one here: https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=

# Ranking source: forbes | usnews
RANKING_SOURCE=forbes

# Forbes ranking page URL containing the current Top Colleges list.
# Example: https://www.forbes.com/top-colleges/
FORBES_RANKING_URL=

# U.S. News ranking page URL (used when RANKING_SOURCE=usnews)
# Example: https://www.usnews.com/best-colleges/rankings/national-universities
USNEWS_RANKING_URL=
